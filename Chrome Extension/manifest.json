{
  "manifest_version": 3,
  "name": "SDC Bulk Downloader Companion",
  "version": "1.1.0",
  "description": "Connect Instagram, Threads or Facebook to the local SDC Bulk Downloader.",
  "permissions": [
    "cookies"
  ],
  "host_permissions": [
    "https://www.instagram.com/*",
    "https://instagram.com/*",
    "http://127.0.0.1/*",
    "https://www.threads.com/*",
    "https://www.threads.net/*",
    "https://www.facebook.com/*"
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
